# Nuffield credentials (required)
NUFFIELD_EMAIL=you@example.com
NUFFIELD_PASSWORD=your-password

# --- Authentication (choose ONE) ---
# Headless-browser login: fetches and refreshes tokens on its own. This is the
# only mode that survives a long-running container, since IDAAS tokens are
# short-lived. Requires Chromium (already baked into the Docker image).
AUTO_LOGIN=true
LOGIN_URL=https://www.nuffieldhealth.com/account/idaaslogin
LOGIN_HEADLESS=true
# Visited after login if the landing page makes no booking-API call itself.
POST_LOGIN_URL=https://my.nuffieldhealth.com/
# Verified against the live B2C sign-in page:
LOGIN_EMAIL_SELECTOR=#email
LOGIN_PASSWORD_SELECTOR=#password
LOGIN_SUBMIT_SELECTOR=#next

# Optional: a token captured by hand (scope booking_api_access). With
# AUTO_LOGIN=true it is used until its `exp` passes, then the browser login
# takes over. With AUTO_LOGIN=false it is the only credential. Never commit one.
BEARER_TOKEN=

# Target class (optional, these are the defaults)
# LOCATION_ID is the gym's Salesforce facility id (Baltimore Wharf below)
LOCATION_ID=a2T4J000001JJgMUAW
# Comma-separated, case-insensitive title substrings. A class matches if ANY apply.
CLASS_NAME_FILTERS=Reformer Pilates - Signature,Reformer Pilates - Foundations
TARGET_DAYS_AHEAD=8

# Safety: when true, detect and notify but never POST a real booking
DRY_RUN=true
# Hold off booking until the first release time after startup. Lets you start
# the container the night before without it grabbing whatever is already open.
BOOK_ONLY_AFTER_RELEASE=true

# Join the waitlist when a matching class is already full
JOIN_WAITLIST=true

# Only book classes starting within this window, local to TIMEZONE (optional)
CLASS_TIME_FROM=11:00
CLASS_TIME_TO=14:00
# Which days a class may fall on. Comma-separated names, inclusive ranges, or
# the aliases weekdays / weekends / daily. e.g. Mon-Fri | Mon,Wed,Fri | weekends
# Baltimore Wharf runs NO evening Reformer at weekends, so an evening window
# only ever matches Mon-Fri.
CLASS_DAYS=Mon-Fri

# Polling cadence (optional). Do not lower BURST_INTERVAL_SECONDS: 0.2s
# exhausted the API rate limit before the drop and the booking POST itself was
# refused with 429. BURST_LEAD_SECONDS is small on purpose, because the target
# day does not exist in the API until the release.
POLL_INTERVAL_SECONDS=5.0
BURST_INTERVAL_SECONDS=1.0
BURST_JITTER_SECONDS=0.2
BURST_LEAD_SECONDS=5.0
BURST_WINDOW_SECONDS=45

# How often to check whether a waitlist place became a real booking (optional)
BOOKING_CHECK_INTERVAL_SECONDS=600

# When bookings open, local to TIMEZONE (optional)
RELEASE_HOUR=7
RELEASE_MINUTE=0
TIMEZONE=Europe/London

# WhatsApp Cloud API notifications (optional, falls back to logs if unset)
NOTIFY_WHATSAPP_TOKEN=
NOTIFY_WHATSAPP_PHONE_NUMBER_ID=
NOTIFY_WHATSAPP_RECIPIENT=
